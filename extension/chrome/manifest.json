{
  "manifest_version": 3,
  "name": "Café da Firma",
  "version": "1.8.1",
  "description": "Registre a feita do café, conte suas xícaras e avalie o café, em um clique, sem abrir o site.",
  "permissions": [
    "storage",
    "notifications",
    "alarms",
    "contextMenus"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Café da Firma",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "registrar-cafe": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Registrar café agora"
    },
    "tomei-cafe": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Tomei um café (conta a xícara e pergunta a nota)"
    },
    "abrir-painel": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Abrir o painel do Café da Firma"
    }
  }
}
